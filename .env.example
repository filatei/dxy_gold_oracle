# Copy to .env for local runs (never commit .env)
# GitHub Actions: set matching names as repository Secrets (forks must re-add).
# See README → "GitHub Secrets (for forks)" for required/optional + workflows.

# --- Telegram (optional; session reports + XAU key-level alerts + feedback) ---
# Workflows: london/ny/asia-session, xau-price-alerts, telegram-feedback, test-telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional XAUUSD alert overrides (defaults in config/xau_price_alerts.json)
# XAU_ALERT_MOVE_PCT=0.5          # % move over the short window
# XAU_ALERT_WINDOW_BARS=4         # bars × interval (4×15m ≈ 1h)
# XAU_ALERT_LEVEL_STEP=50         # psychological round levels ($50)
# XAU_ALERT_LEVEL_PROXIMITY=3     # USD distance to count as "at level"
# XAU_ALERT_COOLDOWN_MINUTES=120  # per (level, direction)

# --- Free / cheap LLM providers (optional; cascade Groq → Gemini → DeepSeek → OpenRouter) ---
# Free/cheap ≠ no API key: register and paste a key. Exact names used in code.
# Workflows: london-session, ny-session, asia-session
GROQ_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# Optional model overrides (repo Variables or env — not secrets)
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_MODEL=gemini-2.0-flash
# DEEPSEEK_MODEL=deepseek-v4-flash
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# OPENROUTER_DEEPSEEK_MODEL=deepseek/deepseek-chat

# --- Local GitHub publishing ---
# Actions injects GITHUB_TOKEN automatically (workflows map it to GH_TOKEN).
# Local full publish needs a PAT with issues:write:
# GH_TOKEN=
# GITHUB_REPOSITORY=filatei/dxy_gold_oracle

# Skip Issue + Telegram when testing analysis locally
# ORACLE_DRY_RUN=1
