# Copy to .env for local runs (never commit .env)
# GitHub Actions: set these as repository Secrets instead.

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Free LLM providers (at least one recommended)
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Optional model overrides
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_MODEL=gemini-2.0-flash
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Local GitHub publishing (Actions injects GITHUB_TOKEN automatically)
# GH_TOKEN=
# GITHUB_REPOSITORY=filatei/dxy_gold_oracle

# Skip Issue + Telegram when testing analysis locally
# ORACLE_DRY_RUN=1
